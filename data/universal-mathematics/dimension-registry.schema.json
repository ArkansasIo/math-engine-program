{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiomforge.example/schemas/dimension-registry.schema.json",
  "title": "Universal Mathematics Dimension Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "aspect",
    "primary_tier",
    "min_score",
    "max_score",
    "definition"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DIM-[0-9]{5}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "aspect": {
      "type": "string",
      "minLength": 1
    },
    "primary_tier": {
      "enum": [
        "Elementary",
        "Middle School",
        "High School",
        "Undergraduate",
        "Graduate",
        "Research",
        "Frontier",
        "Ultra-Frontier"
      ]
    },
    "min_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "max_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DIM-[0-9]{5}$"
      }
    }
  }
}
